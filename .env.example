# Public/internal runtime settings.
APP_ENV=development

# TELEGRAM_API_ID is sensitive. API hash and bot token are secrets.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_BOT_TOKEN=

# Legacy aliases from the previous parser project are also supported:
# API_ID, API_HASH, BOT_TOKEN, TARGET_USER_ID.

# Optional: if omitted, send /start to your bot and it will subscribe that chat.
TELEGRAM_TARGET_CHAT_ID=

# Optional runtime tuning. DATABASE_PATH is the legacy V1 SQLite store.
DATABASE_PATH=data/leads.sqlite3
# Required by the Telegram runtime, Alembic, V2 repositories and import commands.
# DATABASE_PATH remains the read/write legacy delivery/idempotency store during G3.
DATABASE_URL=
SOURCES_PATH=config/sources.json
FILTERS_PATH=config/filters.json
USER_SESSION_PATH=sessions/freelancer_user
BOT_SESSION_PATH=sessions/freelancer_delivery_bot
CATCH_UP_LIMIT=25
SEND_CATCH_UP=false
# V1 SQLite lead notifications are disabled unless explicitly opted in.
LEGACY_DELIVERY_ENABLED=false
LOG_LEVEL=INFO
WORKER_POLL_INTERVAL_SECONDS=1
WORKER_LEASE_SECONDS=30
WORKER_HEARTBEAT_SECONDS=10
WORKER_RETRY_DELAY_SECONDS=5
WORKER_SHUTDOWN_TIMEOUT_SECONDS=20

# Shared OpenAI credential. Reply drafts remain button-triggered; configured
# opportunity analysis consumes durable V2 analysis jobs globally once.
AI_REPLY_ENABLED=false
AI_REPLY_PROVIDER=openai
OPENAI_API_KEY=
AI_REPLY_MODEL=gpt-4.1-mini
AI_REPLY_TEMPERATURE=0.3
AI_REQUEST_TIMEOUT_SECONDS=45
SOURCE_AUDIT_PROVIDER=openai
SOURCE_AUDIT_MODEL=gpt-5-nano
SOURCE_AUDIT_TEMPERATURE=0
SOURCE_AUDIT_TIMEOUT_SECONDS=45
# Source Audit and Telegram Chat Screening use the selected provider below.
# For deepseek or tokenrouter, choose an operator-verified model explicitly.
DEEPSEEK_API_KEY=
TOKENROUTER_API_KEY=
TOKENROUTER_BASE_URL=https://api.tokenrouter.com/v1
# Supported providers: openai, deepseek, tokenrouter. The selected provider
# must have its matching key configured; no automatic provider fallback occurs.
OPPORTUNITY_ANALYSIS_PROVIDER=openai
OPPORTUNITY_ANALYSIS_MODEL=gpt-5-nano
OPPORTUNITY_ANALYSIS_TEMPERATURE=0
OPPORTUNITY_ANALYSIS_TIMEOUT_SECONDS=45
OPPORTUNITY_ANALYSIS_MAX_OUTPUT_ATTEMPTS=2
# Fallback can multiply paid calls; enable only with an explicit budget.
OPPORTUNITY_ANALYSIS_FALLBACK_ENABLED=false
# The fallback provider can independently be openai, deepseek or tokenrouter.
OPPORTUNITY_ANALYSIS_FALLBACK_PROVIDER=openai
OPPORTUNITY_ANALYSIS_FALLBACK_MODEL=gpt-5-mini
OPPORTUNITY_ANALYSIS_CONFIDENCE_THRESHOLD=0.65
OPPORTUNITY_ANALYSIS_ROUTING_VERSION=opportunity-routing.v1
# When using a non-default provider/model, set these pricing inputs to the
# operator-verified values for that provider/model; they are not fetched.
OPPORTUNITY_ANALYSIS_PRICING_VERSION=openai-gpt5-2025-08-07
OPPORTUNITY_ANALYSIS_INPUT_USD_PER_MILLION=0.05
OPPORTUNITY_ANALYSIS_OUTPUT_USD_PER_MILLION=0.40
OPPORTUNITY_ANALYSIS_FALLBACK_INPUT_USD_PER_MILLION=0.25
OPPORTUNITY_ANALYSIS_FALLBACK_OUTPUT_USD_PER_MILLION=2.00
OPPORTUNITY_ANALYSIS_DAILY_SPEND_LIMIT_USD=1.00
OPPORTUNITY_ANALYSIS_MONTHLY_SPEND_LIMIT_USD=10.00
OPPORTUNITY_ANALYSIS_BUDGET_RESERVE_INPUT_TOKENS=1000
OPPORTUNITY_ANALYSIS_BUDGET_RESERVE_OUTPUT_TOKENS=300
ONBOARDING_PROFILE_PROVIDER=openai
ONBOARDING_PROFILE_MODEL=gpt-5-nano
ONBOARDING_PROFILE_TEMPERATURE=0
ONBOARDING_PROFILE_TIMEOUT_SECONDS=45
ONBOARDING_PROFILE_MAX_OUTPUT_ATTEMPTS=2
ONBOARDING_PROFILE_MAX_TRANSPORT_ATTEMPTS=2
ONBOARDING_PROFILE_TRANSPORT_RETRY_BACKOFF_SECONDS=1
MAX_AI_CALLS_PER_RUN=10
# Optional OpenAI-compatible TokenRouter onboarding provider.
# ONBOARDING_PROFILE_PROVIDER=tokenrouter
# ONBOARDING_PROFILE_MODEL=deepseek/deepseek-v4-pro-0813-free

# Versioned deterministic matching decision policy (no AI/provider required)
MATCHING_DECISION_POLICY_VERSION=matching-decision-policy.v1
MATCHING_MINIMUM_RELEVANCE_SCORE=0.3000
MATCHING_MINIMUM_RANK_SCORE=0.4000
MATCHING_FRESHNESS_WEIGHT=0.1000
MATCHING_MAXIMUM_AGE_SECONDS=604800
MATCHING_SUPPRESS_EXPIRED=true
MATCHING_EVALUATION_BUCKET_SECONDS=3600
SOURCE_REAUDIT_DEGRADED_CADENCE_DAYS=7
SOURCE_REAUDIT_HIGH_ACTIVITY_CADENCE_DAYS=7
SOURCE_REAUDIT_NORMAL_CADENCE_DAYS=14
SOURCE_REAUDIT_QUIET_CADENCE_DAYS=30
SOURCE_REAUDIT_HIGH_ACTIVITY_MESSAGES_PER_DAY=50
SOURCE_REAUDIT_QUIET_ACTIVITY_MESSAGES_PER_DAY=5
SOURCE_DISCOVERY_ENABLED=false
SOURCE_AUDIT_ENABLED=false
SOURCE_GRAPH_DISCOVERY_ENABLED=false
# Optional local SearXNG JSON endpoint. Telegram graph discovery still works
# when this is empty; Web Discovery is reported as unavailable, not skipped.
SEARXNG_URL=
# Optional Brave Web Search API key. Web Discovery remains disabled unless
# SOURCE_DISCOVERY_ENABLED=true and a provider is explicitly configured.
BRAVE_SEARCH_API_KEY=
# Used by compose.yaml when the local SearXNG service is enabled.
SEARXNG_PORT=8080
SOURCE_DISCOVERY_INTERVAL_SECONDS=21600
SOURCE_DISCOVERY_SEED_LIMIT=3
SOURCE_DISCOVERY_MESSAGE_LIMIT_PER_SEED=150
SOURCE_DISCOVERY_MAX_CANDIDATES=100
SOURCE_DISCOVERY_MAX_OBSERVATIONS=1000
SOURCE_DISCOVERY_AUDIT_LIMIT=10
SOURCE_DISCOVERY_REAUDIT_LIMIT=3
# Shared per-collector discovery/audit governor. These settings apply only to
# active Telegram crawl requests; passive incoming updates are not paced here.
TELEGRAM_CRAWL_MIN_DELAY_SECONDS=5
TELEGRAM_CRAWL_MAX_DELAY_SECONDS=10
TELEGRAM_SOURCE_COOLDOWN_MIN_SECONDS=15
TELEGRAM_SOURCE_COOLDOWN_MAX_SECONDS=30
# Lightweight graph/history passes remain bounded at 25. Full Source Audit
# uses its own capacity so the unchanged 30/60 evidence policy is reachable.
TELEGRAM_MAX_HISTORY_MESSAGES_PER_PASS=25
SOURCE_AUDIT_SAMPLE_SIZE=60
TELEGRAM_MAX_ENTITY_RESOLVES_PER_GRAPH_PASS=5
TELEGRAM_MAX_AUDITS_PER_BATCH=2
TELEGRAM_GRAPH_SEEDS_PER_PASS=1
TELEGRAM_GOVERNOR_LEASE_SECONDS=900
# Optional durable Telegram chat-discovery worker. It remains off unless this
# flag is explicitly enabled; operator `telegram-discovery run` is bounded.
TELEGRAM_CHAT_DISCOVERY_ENABLED=false
TELEGRAM_CHAT_DISCOVERY_REFRESH_INTERVAL_SECONDS=21600
TELEGRAM_CHAT_DISCOVERY_MAX_TOPICS_PER_CYCLE=5
TELEGRAM_CHAT_DISCOVERY_MAX_PENDING_SCREENS=50
# Optional independent Telegram Chat Screening AI route. When unset, screen
# provider/model inherit SOURCE_AUDIT_PROVIDER/SOURCE_AUDIT_MODEL. Use a
# cheap/fast model for screening when the provider is explicitly selected.
TELEGRAM_CHAT_DISCOVERY_SCREEN_PROVIDER=
TELEGRAM_CHAT_DISCOVERY_SCREEN_MODEL=
TELEGRAM_CHAT_DISCOVERY_SCREEN_TIMEOUT_SECONDS=45
TELEGRAM_CHAT_DISCOVERY_SCREEN_RETRY_INTERVAL_SECONDS=86400
TELEGRAM_CHAT_DISCOVERY_HISTORY_LIMIT=25
TELEGRAM_CHAT_DISCOVERY_SCREEN_MAX_MESSAGE_CHARS=1000
TELEGRAM_CHAT_DISCOVERY_SCREEN_MAX_TOTAL_CHARS=20000
TELEGRAM_CHAT_DISCOVERY_SCREEN_POLICY_VERSION=telegram-chat-screen-policy.v1
TELEGRAM_CHAT_DISCOVERY_SCREEN_MIN_SAMPLE=10
TELEGRAM_CHAT_DISCOVERY_SCREEN_MIN_USEFUL_MESSAGES=3
TELEGRAM_CHAT_DISCOVERY_SCREEN_MIN_USEFUL_RATIO=0.12
TELEGRAM_CHAT_DISCOVERY_SCREEN_MIN_CONFIDENCE=0.65
TELEGRAM_CHAT_DISCOVERY_SCREEN_MAX_SELLER_RATIO=0.70
TELEGRAM_CHAT_DISCOVERY_SCREEN_MAX_SPAM_RATIO=0.70
FREELANCER_PROFILE_PATH=freelancer_profile.json

# OPENAI_MODEL remains a supported legacy alias for AI_REPLY_MODEL.
